# === Return Risk Scorer — Environment Variables ===
# Copy this file to .env and fill in your values.

# Google Gemini API Key (get one at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Model artifact paths (relative to where uvicorn runs from)
MODEL_PATH=../ml/model.pkl
MODEL_VERSION_PATH=../ml/model_version.txt

# SQLite database URL
DATABASE_URL=sqlite:///./return_risk.db

# Risk score decision thresholds
SCORE_THRESHOLD_ALLOW=0.35    # Below this: allow
SCORE_THRESHOLD_BLOCK=0.65    # Above this: block_cod

# Set to true to enable debug logging
DEBUG=false

